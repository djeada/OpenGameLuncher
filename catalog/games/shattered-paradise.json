{
  "$schema": "../game.schema.json",
  "id": "shattered-paradise",
  "name": "Shattered Paradise",
  "mark": "SP",
  "tagline": "Tiberian Sun on OpenRA with five factions: GDI, Nod, the Forgotten, CABAL and the Scrin.",
  "website": "https://github.com/ABrandau/Shattered-Paradise-SDK",
  "note": "The free game content downloads on first start.",
  "accent": "#2e7d32",
  "cover": "https://media.moddb.com/images/mods/1/28/27581/ice2lava.gif",
  "icon": "https://raw.githubusercontent.com/ABrandau/Shattered-Paradise-SDK/bleed/packaging/artwork/icon_512x512.png",
  "screenshots": [
    "https://media.moddb.com/images/mods/1/28/27581/ice2lava.gif",
    "https://media.moddb.com/images/mods/1/28/27581/emm3.gif",
    "https://media.moddb.com/images/mods/1/28/27581/orca_new2.gif",
    "https://media.moddb.com/images/mods/1/28/27581/kodiac3.gif",
    "https://media.moddb.com/images/mods/1/28/27581/scrin-civilian.gif"
  ],
  "tags": ["Strategy", "RTS"],
  "channels": [
    {
      "id": "release",
      "label": "Release",
      "description": "Stable releases.",
      "source": {
        "type": "github-releases",
        "owner": "ABrandau",
        "repo": "Shattered-Paradise-SDK",
        "prerelease": "exclude"
      }
    }
  ],
  "platforms": {
    "darwin": {
      "asset": {
        "include": [".dmg"]
      },
      "archive": "dmg",
      "launch": { "app": "OpenRA - Shattered Paradise.app" }
    },
    "win32": {
      "asset": {
        "include": ["winportable"],
        "arch": {
          "x64": ["x64"],
          "ia32": ["x86"]
        }
      },
      "archive": "zip",
      "launch": { "binary": "ShatteredParadise.exe" }
    },
    "linux": {
      "asset": {
        "include": [".appimage"],
        "exclude": ["zsync"],
        "arch": {
          "x64": ["x86_64"]
        }
      },
      "archive": "file"
    }
  }
}
